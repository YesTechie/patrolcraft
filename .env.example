# PatrolCraft settings. The installer writes .env for you with a unique login and secret.
# This is the PatrolCraft sign-in, not a UniFi login.
APP_USER=
APP_PASS=
APP_SECRET=

# Listen address. Keep 127.0.0.1 so only this computer can open PatrolCraft.
APP_HOST=127.0.0.1
APP_PORT=8080

# UniFi console. You can also set these on the Config page after you sign in.
UNIFI_HOST=
UNIFI_PORT=443
UNIFI_USER=
UNIFI_PASS=
UNIFI_VERIFY_TLS=false
UNIFI_SITE=default
# Optional Integration API key, used by Refresh snapshot.
UNIFI_API_KEY=
